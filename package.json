{
  "name": "@scope/dsh-session-folders",
  "version": "0.5.0",
  "description": "Session folders for the DSH 0.2.x web sidebar (fork of dsh-session-folders): one level of named folders per workspace, drag-and-drop or context menu to move sessions, server-side persistence. Auto rename is not included.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "FORK-NOTES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible"
      }
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "folders",
    "sessions",
    "sidebar",
    "dsh-plugin",
    "fork"
  ],
  "author": "Eugene",
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmitriyValetov/dsh-session-folders.git"
  },
  "homepage": "https://github.com/DmitriyValetov/dsh-session-folders#readme",
  "bugs": {
    "url": "https://github.com/DmitriyValetov/dsh-session-folders/issues"
  }
}
